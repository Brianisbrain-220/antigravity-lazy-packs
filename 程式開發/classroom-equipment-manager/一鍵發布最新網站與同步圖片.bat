@echo off
chcp 65001 >nul
title 中正國小教室設備管理系統 - 一鍵更新發布與同步工具
color 0B
echo ===============================================================================
echo     中正國小教室設備管理系統 - 一鍵發布與 GitHub 同步工具
echo ===============================================================================
echo.
echo 💡 小提示：在執行本檔案前，請確認：
echo    1. 您的設備照片已放入 public\images\equipment\ 資料夾
echo    2. 您已在網頁後台填寫好圖片檔名（例如 /images/equipment/xxxx.jpg）
echo.
echo ===============================================================================
echo [1/3] 正在編譯打包最新網站與設備相片...
echo ===============================================================================
call npm run build
if errorlevel 1 (
    color 0C
    echo.
    echo [❌ 發生錯誤] 網站編譯失敗！請檢查是否有程式碼語法問題。
    pause
    exit /b 1
)

echo.
echo ===============================================================================
echo [2/3] 正在將新相片與網站發布到 Google Firebase 雲端...
echo ===============================================================================
call npx firebase deploy --only hosting
if errorlevel 1 (
    color 0C
    echo.
    echo [❌ 發生錯誤] 雲端發布失敗！請檢查電腦的網路連線是否正常。
    pause
    exit /b 1
)

echo.
echo ===============================================================================
echo [3/3] 正在同步備份所有變更到 GitHub 雲端儲存庫...
echo ===============================================================================
cd ..\..
call git add .
call git commit -m "chore(deploy): 一鍵同步設備圖片與網站正式發布"
call git push origin main

color 0A
echo.
echo ===============================================================================
echo   🎉 全部恭喜！新圖片已上線到網站，同時也完成 GitHub 雲端永久備份！
echo ===============================================================================
echo   現在可以關閉本視窗，或者按任意鍵結束。
echo.
pause
