@echo off
chcp 65001 >nul
title 中正國小停車管理與 ETC 登記系統 - 一鍵更新發布工具
color 0B
echo ===============================================================================
echo     中正國小停車管理與 ETC 登記系統 - 一鍵編譯與 Firebase 雲端發布工具
echo ===============================================================================
echo.
echo [1/3] 正在編譯打包最新網站...
echo ===============================================================================
call npm run build
if errorlevel 1 (
    color 0C
    echo.
    echo [❌ 發生錯誤] 網站編譯失敗！請檢查是否有程式碼語法問題。
    pause
    exit /b 1
)

echo.
echo ===============================================================================
echo [2/3] 正在將網站發布到 Google Firebase 雲端 (https://cjps-parking.web.app)...
echo ===============================================================================
call npx.cmd firebase-tools@latest deploy --only hosting
if errorlevel 1 (
    color 0C
    echo.
    echo [❌ 發生錯誤] 雲端發布失敗！請檢查電腦的網路連線是否正常。
    pause
    exit /b 1
)

echo.
echo ===============================================================================
echo [3/3] 正在同步備份所有變更到 GitHub 雲端儲存庫...
echo ===============================================================================
call git add .
call git commit -m "chore(deploy): 一鍵更新與發布 Firebase 網站"
call git push origin main

color 0A
echo.
echo ===============================================================================
echo   🎉 恭喜！最新版本的停車管理與 ETC 登記系統已正式上線！
echo   線上網址：https://cjps-parking.web.app
echo ===============================================================================
echo   現在可以關閉本視窗，或者按任意鍵結束。
echo.
pause
